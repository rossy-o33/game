const tierColor=t=>[0x8d5b4c,0x0288d1,0xffb300,0x7b1fa2,0x00e676][t-1]||new THREE.Color().setHSL((t*.137)%1,.75,.55).getHex();
const tsc=t=>Math.min(.7+.38*(t-1),2.6);
