const gU=new THREE.BoxGeometry(1,1,1),gBullet=new THREE.SphereGeometry(.13,6,6),gPart=new THREE.BoxGeometry(.14,.14,.14),gShot=new THREE.SphereGeometry(.45,8,8),gBarrel=new THREE.CylinderGeometry(.9,.9,1.8,14),
gBody=new THREE.SphereGeometry(.38,10,10),gHead=new THREE.SphereGeometry(.32,10,10),gEar=new THREE.SphereGeometry(.14,6,6),gSm=new THREE.SphereGeometry(.1,6,6),gTor=new THREE.TorusGeometry(.3,.045,6,14),gPlane=new THREE.PlaneGeometry(.7,.9),gCone=new THREE.ConeGeometry(.07,.2,4),gHoop=new THREE.TorusGeometry(.93,.07,6,16);
