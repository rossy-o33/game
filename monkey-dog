function breakBarrel(b){const k=b.kind,add=2+(stage>>2);if(k==='shield')P.shield=6;else{P.weapon=k;P.wT=15}setMonkeys(monkeys+BigInt(add));score+=200;toast(K[k].n+'!  +'+add,'#4fc3f7');AE.se('power');burst(b.g.position.x,1,b.g.position.z,K[k].c,10)}
