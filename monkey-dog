if(g.t==='add')n=p+v;else if(g.t==='mul'){n=p*BigInt(Math.round(g.v*100))/100n;if(n<=p)n=p+1n}else if(g.t==='pct'){const x=p*v/100n;n=p+(x<1n?1n:x)}else if(g.t==='sub')n=p-v;else{n=p-p*v/100n}
if(n<1n)n=1n;AE.se(n>=p?'good':'bad');if(n<p)toast('-'+fmt(p-n),'#ff5252');else toast('+'+fmt(n-p),'#4fc3f7');setMonkeys(n)}
function useSkill(){if(state!=='PLAYING'||P.skill>0)return;P.skill=SKILL_CD;shake=.9;AE.se('boom');ring(0xffeb3b,22);const d=250+pw*40;
enemies.forEach(e=>{dmgEnemy(e,d);burst(e.g.position.x,1.2,e.g.position.z,0xffeb3b,3)});barrels.forEach(b=>b.hp-=d);shots.forEach(s=>scene.remove(s.g));shots=[]}
$('skill').addEventListener('click',useSkill);
addEventListener('keydown',e=>{if(e.code==='Space')useSkill();if(e.code==='ArrowLeft'||e.code==='KeyA')P.tx=Math.max(-4.5,P.tx-1);if(e.code==='ArrowRight'||e.code==='KeyD')P.tx=Math.min(4.5,P.tx+1)});
function pointer(e){const r=G.getBoundingClientRect();P.tx=((e.clientX-r.left)/r.width-.5)*9}
G.addEventListener('pointermove',pointer);G.addEventListener('pointerdown',pointer);

function fire(){const w=W[P.weapon],n=Math.min(members.length,12);P.shoot=w.cd*Math.pow(.88,P.rate);if(!n)return;const dmg=w.dmg*pw/n*(1+P.atk*.25);AE.se('shoot');
for(let i=0;i<n&&bullets.length<80;i++){const m=members[i],t=m.userData.t,mesh=new THREE.Mesh(gBullet,B(P.weapon==='rocket'?0xffffff:P.weapon==='gatling'?0x69f0ae:0x40e0ff));
{const k=(P.weapon==='rocket'?1.8:1)*Math.min(1+(t-1)*.35,3);mesh.scale.set(k*.8,k*.8,k*3.2)}mesh.position.set(squad.position.x+m.position.x,.7+m.scale.x*.3,SQ_Z+m.position.z-.4);scene.add(mesh);bullets.push({g:mesh,dmg,pierce:!!w.pierce,hit:new Set(),gh:new Set(),dead:false})}}

/* ---------- Update ---------- */
function update(dt){T+=dt;P.x+=(P.tx-P.x)*Math.min(1,dt*14);squad.position.x=P.x;
P.inv=Math.max(0,P.inv-dt);P.skill=Math.max(0,P.skill-dt);P.shield=Math.max(0,P.shield-dt);comboT-=dt;if(comboT<=0)combo=0;
if(P.wT>0){P.wT-=dt;if(P.wT<=0)P.weapon='pistol'}
const wasRush=rush;rush=stage>1&&!boss&&T>12&&T<22;if(wasRush!==rush){$('rush').style.display=rush?'block':'none';AE.bgm(stage,rush)}
const smT=speedMod();smC+=(smT-smC)*Math.min(1,dt*3);speedToast();const WS=10*gs*smC*(rush?1.5:1);wsLast=WS;scrollWorld(WS*dt);fx(dt);
members.forEach((m,i)=>{m.position.y=Math.abs(Math.sin(T*12+i))*.12*m.scale.x;if(m.userData.aura)m.userData.aura.rotation.z=T*3});
shieldMesh.visible=P.shield>0;squad.visible=P.inv<=0||P.shield>0||Math.floor(T*20)%2===0;

if(!boss&&T<BOSS_AT){
 sp.dog-=dt;if(sp.dog<=0){spawnDog();sp.dog=Math.max(.3,(.7-stage*.03)/(rush?1.6:1)/gs)*(stage===1?1.3:1)*(.7+Math.random()*.6)}
 sp.gate-=dt;if(sp.gate<=0){spawnGates(-48,false);sp.gate=(4.2+Math.random()*1.5)/Math.sqrt(gs)}
 sp.barrel-=dt;if(sp.barrel<=0){spawnBarrel();sp.barrel=3.4+Math.random()*2}
 sp.haz-=dt;if(sp.haz<=0){spawnHazard();sp.haz=Math.max(3,7-stage*.5)+Math.random()*3}}
if(!boss&&T>=BOSS_AT)spawnBoss();
P.shoot-=dt;if(P.shoot<=0)fire();

for(let i=bullets.length-1;i>=0;i--){const b=bullets[i];b.g.position.z-=60*dt;const bx_=b.g.position.x,bz=b.g.position.z;
 for(const br of barrels){if(Math.abs(bz-br.g.position.z)<1.2&&Math.abs(bx_-br.g.position.x)<1.2){br.hp-=b.dmg;b.dead=true;break}}
 for(const gt of gates){if(!gt.done&&!b.gh.has(gt)&&Math.abs(bz-gt.g.position.z)<1.3&&Math.abs(bx_-gt.x)<2.3){b.gh.add(gt);gateHit(gt)}}
 if(!b.dead)for(const h of hazards){if(Math.abs(bx_-h.x)<h.w/2&&Math.abs(bz-h.g.position.z)<h.len/2){b.dead=true;break}}
 if(!b.dead)for(const e of enemies){if(Math.abs(bz-e.g.position.z)<(e.boss?2.5:1.4)&&Math.abs(bx_-e.g.position.x)<e.hw){if(b.pierce){if(!b.hit.has(e)){b.hit.add(e);dmgEnemy(e,b.dmg)}}else{dmgEnemy(e,b.dmg);b.dead=true;break}}}
 if(bz<-60||b.dead){scene.remove(b.g);bullets.splice(i,1)}}

const sx=squad.position.x;
for(let i=enemies.length-1;i>=0;i--){const e=enemies[i];e.flash=Math.max(0,e.flash-dt);e.g.scale.setScalar(1+e.flash*1.2);
 e.legs.forEach((l,k)=>l.rotation.x=Math.sin(T*(e.boss?5:10)+(k%3?3.14:0))*.6);e.tail.rotation.y=Math.sin(T*12+i)*.5;
 if(e.boss){e.t+=dt;const ez=e.g.position.z;
  if(!e.in){e.g.position.z=Math.min(-16,ez+14*gs*dt);if(e.g.position.z>=-16)e.in=1}
  else if(bossAI(e,dt,sx)){e.fire-=dt;
   if(e.phase===1&&e.hp<e.max*.5){e.phase=2;toast('RAGE MODE!','#ff1744');AE.se('boom')}
   if(e.fire<=0){e.fire=(e.phase===2?.85:1.4)/Math.sqrt(gs);const n=e.phase===2?5:3,a0=Math.atan2(sx-e.g.position.x,SQ_Z-e.g.position.z);
    for(let k=0;k<n;k++){const a=a0+(k-(n-1)/2)*.22;bshot(e.g.position.x,e.g.position.z+2,Math.sin(a)*17*gs,Math.cos(a)*17*gs)}AE.se('hurt')}
   if(e.phase===2){e.mt-=dt;if(e.mt<=0){e.mt=2.5;spawnDog()}}}
  $('bossbar').style.width=Math.max(0,e.hp/e.max*100)+'%';
 }else{const p=e.g.position;dogAI(e,dt,sx);p.y=Math.abs(Math.sin(T*10+i))*.15;
  if(hitSq(p.x,p.z,e.hw,1.1)){hurt(3+(stage*.8|0));burst(p.x,1,p.z,0xff5722,5);scene.remove(e.g);enemies.splice(i,1);continue}
  if(p.z>14){scene.remove(e.g);enemies.splice(i,1);continue}}
 if(e.hp<=0){scene.remove(e.g);enemies.splice(i,1);if(e.boss)boss=null;kill(e)}}

for(let i=shots.length-1;i>=0;i--){const s=shots[i];s.g.position.x+=s.vx*dt;s.g.position.z+=s.vz*dt;if(s.vx||s.vz)s.g.rotation.y+=dt*8;
 if((s.vx||s.vz)&&hitSq(s.g.position.x,s.g.position.z,.45,.45)){hurt(s.d||2+(stage>>1));scene.remove(s.g);shots.splice(i,1);continue}
 if(s.g.position.z>14||Math.abs(s.g.position.x)>12){scene.remove(s.g);shots.splice(i,1)}}

for(let i=barrels.length-1;i>=0;i--){const b=barrels[i];b.g.position.z+=(WS*1.5+4)*dt;b.m.rotation.x+=(WS*1.5+4)*1.1*dt;const p=Math.max(0,b.hp/b.max);b.fill.scale.x=p;b.fill.position.x=-(1-p)*.68;
 if(b.hp<=0){scene.remove(b.g);barrels.splice(i,1);breakBarrel(b);continue}
 if(hitSq(b.g.position.x,b.g.position.z,.9,.9)){hurt(3);AE.se('boom');burst(b.g.position.x,1,b.g.position.z,0xff3d00,8);scene.remove(b.g);barrels.splice(i,1);continue}
 if(b.g.position.z>14){scene.remove(b.g);barrels.splice(i,1)}}

for(let i=gates.length-1;i>=0;i--){const g=gates[i];g.g.position.z+=WS*dt;if(g.dirty){g.dirty=false;drawGate(g)}g.pulse=Math.max(0,g.pulse-dt);g.g.scale.setScalar(1+g.pulse*1.5);
 if(!g.done&&g.g.position.z>=SQ_Z){g.done=true;if(Math.abs(g.x-sx)<2.3)applyGate(g)}
 if(g.g.position.z>14){scene.remove(g.g);gates.splice(i,1)}}

updHazards(dt,WS);
if(state==='PLAYING'&&cleared){cleared=false;score+=1000*stage;saveHi();
 [bullets,shots,barrels,gates,enemies,hazards].forEach(a=>{a.forEach(o=>scene.remove(o.g));a.length=0});
 if(stage>=10){state='ENDING';AE.stopBgm();AE.se('power');ending()}else{state='TRANS';transT=6;P.inv=3;spawnItems()}}
}

function hud(){$('h-stage').textContent='STAGE '+stage+'/10';$('h-squad').textContent='🐵 '+fmt(monkeys)+'  T'+monkeys.toString().length;$('h-score').textContent=score;
$('combo').textContent=combo>=2?'COMBO ×'+combo:'';$('prog-i').style.width=Math.min(1,T/BOSS_AT)*100+'%';if(boss)$('prog').style.display='none';
let w=P.wT>0?P.weapon.toUpperCase()+' '+Math.ceil(P.wT)+'s':'PISTOL';if(P.shield>0)w+='  🛡️'+Math.ceil(P.shield)+'s';if(P.atk||P.rate)w+='  ⚔️'+P.atk+' ⚡'+P.rate;$('wp').textContent=w;
$('cd').style.height=(P.skill/SKILL_CD*100)+'%'}

const clock=new THREE.Clock();
function loop(){requestAnimationFrame(loop);const dt=Math.min(clock.getDelta(),.05);
if(state==='PLAYING'){update(dt);hud()}
else if(state==='TRANS'){transT-=dt;P.x+=(P.tx-P.x)*Math.min(1,dt*14);squad.position.x=P.x;squad.visible=true;scrollWorld(wsLast*dt);fx(dt);members.forEach((m,i)=>m.position.y=Math.abs(Math.sin(T*12+i))*.12*m.scale.x);T+=dt;updItems(dt);hud();if(transT<=0)initStageNext()}
else{scrollWorld(5*dt);fx(dt)}
shake=Math.max(0,shake-dt*2.5);camera.position.set((Math.random()-.5)*shake,10.2+(Math.random()-.5)*shake,14);
camera.fov+=((rush?66:58)-camera.fov)*Math.min(1,dt*4);camera.updateProjectionMatrix();camera.lookAt(0,1.8,-4);
renderer.render(scene,camera)}
function initStageNext(){setMonkeys(monkeys+3n);initStage(stage+1)}
const BV=[{c:0xffb74d,s:4.2,h:1,x:'crown'},{c:0x8e24aa,s:5.5,h:2,x:'horns'},{c:0x424242,s:5.8,h:3,x:'flame'},{c:0xc9a26b,s:6,h:1,x:'spikes'},{c:0xff7043,s:5.2,h:2,x:'horns+crown'},{c:0x1e88e5,s:6.2,h:1,x:'fins'},{c:0xb3e5fc,s:5.8,h:2,x:'horns+fins'},{c:0xff5722,s:6.4,h:3,x:'flame+spikes'},{c:0x3949ab,s:6,h:1,x:'ears+crown'},{c:0xffd600,s:7,h:3,x:'crown+spikes+flame'}];
const POOL=[['barrage','charge'],['curtain','summon','slam'],['rain','beam','barrage'],['charge','spiral','slam'],['curtain','summon','barrage','charge'],['rain','curtain','beam'],['spiral','charge','summon'],['slam','rain','beam','spiral'],['curtain','spiral','beam','summon'],['charge','curtain','barrage','summon','slam','rain','beam','spiral']];
Object.assign(WARN,{beam:'⚠️ レーザー！',rain:'弾の雨！',spiral:'らせん弾！'});
const ITEMS={atk:{i:'⚔️',n:'攻撃力UP',c:0xff5252},rate:{i:'⚡',n:'連射UP',c:0xffc107},mate:{i:'🐵',n:'仲間+15%',c:0x43a047}};
function itemTex(k){const key='it'+k;if(!mc[key]){const I=ITEMS[k],c=document.createElement('canvas');c.width=128;c.height=160;const x=c.getContext('2d');x.fillStyle='#'+I.c.toString(16).padStart(6,'0');x.beginPath();x.arc(64,62,56,0,7);x.fill();x.strokeStyle='#fff';x.lineWidth=6;x.stroke();x.font='60px serif';x.textAlign='center';x.textBaseline='middle';x.fillText(I.i,64,68);x.font='bold 22px sans-serif';x.lineWidth=5;x.strokeStyle='#000';x.strokeText(I.n,64,140);x.fillStyle='#fff';x.fillText(I.n,64,140);mc[key]=new THREE.CanvasTexture(c)}return mc[key]}
function spawnItems(){['atk','rate','mate'].forEach((k,i)=>{const sp_=new THREE.Sprite(new THREE.SpriteMaterial({map:itemTex(k),depthTest:false}));sp_.scale.set(2.6,3.25,1);sp_.position.set((i-1)*3.2,2,-30);scene.add(sp_);items.push({g:sp_,k,x:(i-1)*3.2})});toast('パワーアップを選べ！','#ffd54f')}
function takeItem(k){AE.se('power');ring(ITEMS[k].c,16);burst(squad.position.x,1.5,SQ_Z,ITEMS[k].c,18);
if(k==='atk')P.atk++;else if(k==='rate')P.rate=Math.min(P.rate+1,8);else{const x=monkeys*15n/100n;setMonkeys(monkeys+(x<5n?5n:x))}
toast(ITEMS[k].n+'！','#ffd54f')}
function updItems(dt){for(let i=items.length-1;i>=0;i--){const it=items[i];it.g.position.z+=12*dt;it.g.position.y=2+Math.sin(T*6+i)*.3;
if(it.g.position.z>=SQ_Z){if(Math.abs(it.x-squad.position.x)<1.8){takeItem(it.k);items.forEach(o=>scene.remove(o.g));items.length=0;transT=Math.min(transT,1);return}scene.remove(it.g);items.splice(i,1)}}
if(!items.length&&transT>1)transT=1}
function spawnHazard(){if(Math.random()<.55){hazWall();return}const len=5+Math.random()*4,lanes=[-3.4,0,3.4].sort(()=>Math.random()-.5),n=Math.random()<.35?2:1;
for(let k=0;k<n;k++)hazBlock(lanes[k],3.2,len,-50-len/2)}
const hzTex=(()=>{const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');x.fillStyle='#222';x.fillRect(0,0,64,64);x.fillStyle='#ffc107';for(let i=-1;i<4;i++){x.beginPath();x.moveTo(i*24,64);x.lineTo(i*24+12,64);x.lineTo(i*24+76,0);x.lineTo(i*24+64,0);x.fill()}return new THREE.CanvasTexture(c)})(),hzMat=new THREE.MeshStandardMaterial({map:hzTex,roughness:.6});
function hazBlock(x,w,len,z){const g=new THREE.Group(),H=2.6;g.add(bx(w,H,len,hzMat,0,H/2,0));g.add(bx(w+.2,.3,len+.2,E(0xff3d00),0,H+.1,0));
const nx=Math.max(2,Math.round(w/.9)),nz=Math.max(1,Math.round(len/1.8));
for(let i=0;i<nx;i++)for(let k=0;k<nz;k++){const c=new THREE.Mesh(gCone,M(0xdddddd));c.scale.set(3.5,3.5,3.5);c.position.set(-w/2+(i+.5)*w/nx,H+.55,-len/2+(k+.5)*len/nz);g.add(c)}
g.position.set(x,0,z);scene.add(g);hazards.push({g,x,w,len})}
function hazWall(){const gw=Math.max(3.6,5.2-stage*.15),gc=(Math.random()-.5)*5.6,L=gc-gw/2,R=gc+gw/2,wl=L+7.6,wr=7.6-R;hazBlock(-7.6+wl/2,wl,2.4,-50);hazBlock(7.6-wr/2,wr,2.4,-50);toast('⚠️ 壁が迫る！隙間へ','#ff9800')}
function drawGate(gt){const x=gt.cx,f=Math.floor(gt.v),lb=gt.t==='mul'?'×'+gt.v.toFixed(2):gt.t==='add'?'+'+f:gt.t==='pct'?'+'+f+'%':gt.t==='sub'?'-'+f:'-'+f+'%';
x.fillStyle=gt.t==='mul'?'#f9a825':gt.plus?'#0288d1':'#c62828';x.fillRect(0,0,160,80);x.strokeStyle='#fff';x.lineWidth=6;x.strokeRect(3,3,154,74);x.fillStyle='#fff';x.textAlign='center';x.textBaseline='middle';x.font='bold 14px Arial';x.fillText('SHOOT!',80,15);x.font='bold 38px Arial';x.fillText(lb,80,48);gt.tex.needsUpdate=true}
function gateHit(gt){const t=gt.t;if(t==='add')gt.v+=.15;else if(t==='pct')gt.v+=.12;else if(t==='mul')gt.v=Math.min(3,gt.v+.004);else{gt.v-=t==='sub'?.15:.12;if(gt.v<=0){gt.t=t==='sub'?'add':'pct';gt.plus=true;gt.v=-gt.v}}gt.pulse=.15;gt.dirty=true}
function updHazards(dt,ws){for(let i=hazards.length-1;i>=0;i--){const h=hazards[i],q=h.g.position;q.z+=ws*dt;
if(state==='PLAYING'&&hitSq(h.x,q.z,h.w/2,h.len/2))hurt(1+(stage>>1));
if(q.z-h.len/2>14){scene.remove(h.g);hazards.splice(i,1)}}}
function speedMod(){if(boss)return 1;switch(stage){case 3:return Math.sin(T*.55)>0?1.9:.55;case 5:return .6+Math.min(T,30)/30*1.8;case 6:return 1.7;case 8:return(T%14>6&&T%14<12)?2.6:.8;case 9:return 1.2+.9*Math.sin(T*1.3);default:return 1}}
function speedToast(){if(![3,5,6,8,9].includes(stage))return;const c=smC>1.5?2:smC<.7?0:1;if(c!==lastCat){lastCat=c;toast(c===2?'⚡ TURBO！':c===0?'🐢 SLOW…':'NORMAL','#ffeb3b')}}
applyEnv(1);syncSquad();title();loop();
</script>
