    </div>

    <script>
        // --- 1. Web Audio API サウンドシステム ---
        let audioCtx = null;
        let isMuted = true;
        let bgmInterval = null;

        function initAudio() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function toggleAudio() {
            initAudio();
            isMuted = !isMuted;
            document.getElementById('sound-icon').innerText = isMuted ? "🔇" : "🔊";
            
            if (isMuted) {
                stopBgm();
            } else {
                startBgm();
                playSfx('button');
            }
        }

        function playTone(freq, type, duration, gainValue = 0.1) {
            if (isMuted || !audioCtx) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(gainValue, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {}
        }

        function playSfx(type) {
            if (isMuted || !audioCtx) return;
            initAudio();

            if (type === 'button') {
                playTone(400, 'square', 0.08, 0.08);
            } else if (type === 'feed') {
                playTone(220, 'square', 0.07, 0.1);
                setTimeout(() => playTone(330, 'square', 0.08, 0.1), 70);
            } else if (type === 'play') {
                playTone(500, 'sawtooth', 0.06, 0.08);
                setTimeout(() => playTone(650, 'sawtooth', 0.08, 0.08), 60);
            } else if (type === 'pet') {
                playTone(580, 'sine', 0.1, 0.08);
                setTimeout(() => playTone(750, 'sine', 0.12, 0.08), 80);
            } else if (type === 'evo') {
                const notes = [220, 277, 330, 440, 554, 659, 880];
                notes.forEach((freq, idx) => {
                    setTimeout(() => playTone(freq, 'square', 0.1, 0.1), idx * 60);
                });
            } else if (type === 'marry') {
                const melody = [440, 554, 659, 880, 659, 880];
                melody.forEach((freq, idx) => {
                    setTimeout(() => playTone(freq, 'triangle', 0.15, 0.1), idx * 120);
                });
            } else if (type === 'ascend') {
                for (let i = 0; i < 12; i++) {
                    setTimeout(() => playTone(300 + i * 70, 'sine', 0.15, 0.08), i * 90);
                }
            }
        }

        function startBgm() {
            stopBgm();
            if (isMuted) return;

            const bgmNotes = [
                220.00, 277.18, 329.63, 440.00,
                277.18, 329.63, 440.00, 554.37,
                246.94, 311.13, 369.99, 493.88,
                329.63, 415.30, 493.88, 659.25
            ];
            let noteIdx = 0;

            bgmInterval = setInterval(() => {
                if (!isMuted && audioCtx) {
                    playTone(bgmNotes[noteIdx], 'square', 0.12, 0.025);
                    noteIdx = (noteIdx + 1) % bgmNotes.length;
                }
            }, 230);
        }

        function stopBgm() {
            if (bgmInterval) {
                clearInterval(bgmInterval);
                bgmInterval = null;
            }
        }

        // --- 2. 100名分の日本人名リスト（完全個別） ---
        const JAPANESE_NAMES = [
            "タロウ", "ハナコ", "レン", "アオイ", "リク", "ヒナタ", "サクラ", "カイト", "ユウキ", "ミソラ",
            "ソウタ", "リン", "ヤマト", "ツバサ", "コハク", "メイ", "イツキ", "ヒロ", "ハルト", "ユイ",
            "タクミ", "アカリ", "ショウタ", "ヒカリ", "ダイチ", "フウカ", "ケント", "ミナト", "ハルキ", "ナナミ",
            "コウキ", "ホノカ", "レイ", "カエデ", "シン", "スズ", "ハヤト", "リオ", "ソラ", "ツムギ",
            "ユウリ", "カンタ", "アスカ", "リョウ", "チヒロ", "カイ", "モモカ", "ダイキ", "ミユ", "セイヤ",
            "サラ", "ヒロト", "アイ", "ユウマ", "ココロ", "タツキ", "スミレ", "ケンシン", "カノン", "リクエ",
            "トモヤ", "シオリ", "ナオキ", "ユウナ", "カズキ", "マイ", "リュウ", "ハルナ", "コウタ", "ヒヨリ",
            "マサト", "リコ", "タイガ", "ミサキ", "シュン", "アヤネ", "ソウマ", "カリン", "トウマ", "ノゾミ",
            "ヒデキ", "エミリ", "コウジ", "ミコト", "ユウタ", "ハナ", "タケシ", "キコ", "ショウ", "ルナ",
            "リュウセイ", "ヒカゲ", "ゴウ", "マヒロ", "ジン", "ミヤビ", "ケンジ", "ツノ", "カイリ", "アマツ"
        ];

        // --- 3. 本格的でリッチなキャラデザ＆サイズ感SVG生成システム ---
        function generatePixelArtSvg(id, isLocked = false) {
            if (isLocked) {
                return `
                <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <rect x="25" y="25" width="50" height="50" rx="15" fill="#0f380f"/>
                    <text x="50" y="62" font-family="'Press Start 2P', monospace" font-size="32" fill="#8bac0f" text-anchor="middle">?</text>
                </svg>`;
            }

            // 5つの系統分類: 0: 悪者系, 1: レア系, 2: 自然系, 3: ファンタジー系, 4: 伝説系
            const categoryIndex = (id - 1) % 5;
            
            // パレット定義
            const palettes = [
                { main: '#7209b7', sub: '#b5179e', accent: '#ff4d6d', eye: '#ff70a6' }, // 悪者系
                { main: '#00b4d8', sub: '#90e0ef', accent: '#ffd166', eye: '#03045e' }, // レア系
                { main: '#2b9348', sub: '#55a630', accent: '#aacc00', eye: '#0f380f' }, // 自然系
                { main: '#f72585', sub: '#b5179e', accent: '#4cc9f0', eye: '#ffffff' }, // ファンタジー
                { main: '#ffd166', sub: '#f3722c', accent: '#f8961e', eye: '#ffffff' }  // 伝説系
            ];
            const p = palettes[categoryIndex];

            // サイズ感・スケールの明確な違いを定義
            const scaleVariations = [
                'transform: scale(0.65); transform-origin: center;', // 小型
                'transform: scale(0.85); transform-origin: center;', // 中小型
                'transform: scale(1.0); transform-origin: center;',  // 中型
                'transform: scale(1.15); transform-origin: center;', // 大型
                'transform: scale(1.35); transform-origin: center;'  // 超大型（画面満杯）
            ];
            const scaleStyle = scaleVariations[(id * 3) % 5];

            // 形状バリエーション
            const shapeType = id % 6;
            let svgContent = '';

            if (shapeType === 0) {
                // 角付き悪者系
                svgContent = `
                    <polygon points="30,20 50,5 70,20" fill="${p.sub}"/>
                    <rect x="20" y="25" width="60" height="60" rx="15" fill="${p.main}" stroke="#0f380f" stroke-width="3"/>
                    <polygon points="15,40 25,35 25,55" fill="${p.accent}"/>
                    <polygon points="85,40 75,35 75,55" fill="${p.accent}"/>
                    <circle cx="38" cy="45" r="7" fill="${p.eye}"/>
                    <circle cx="62" cy="45" r="7" fill="${p.eye}"/>
                    <circle cx="39" cy="44" r="2" fill="#000"/>
                    <circle cx="61" cy="44" r="2" fill="#000"/>
                    <path d="M40 68 Q50 58 60 68" stroke="#0f380f" stroke-width="4" fill="none" stroke-linecap="round"/>
                `;
            } else if (shapeType === 1) {
                // シャープなレア系
                svgContent = `
                    <ellipse cx="50" cy="55" rx="22" ry="32" fill="${p.main}" stroke="#0f380f" stroke-width="3"/>
                    <path d="M30 35 L15 20 L35 30 Z" fill="${p.sub}"/>
                    <path d="M70 35 L85 20 L65 30 Z" fill="${p.sub}"/>
                    <ellipse cx="50" cy="45" rx="12" ry="16" fill="${p.sub}"/>
                    <circle cx="42" cy="42" r="5" fill="${p.eye}"/>
                    <circle cx="58" cy="42" r="5" fill="${p.eye}"/>
                    <path d="M45 60 Q50 65 55 60" stroke="#0f380f" stroke-width="3" fill="none"/>
                    <circle cx="50" cy="22" r="6" fill="${p.accent}"/>
                `;
            } else if (shapeType === 2) {
                // 妖精・小動物系
                svgContent = `
                    <circle cx="50" cy="55" r="24" fill="${p.main}" stroke="#0f380f" stroke-width="3"/>
                    <circle cx="30" cy="30" r="12" fill="${p.sub}" stroke="#0f380f" stroke-width="2"/>
                    <circle cx="70" cy="30" r="12" fill="${p.sub}" stroke="#0f380f" stroke-width="2"/>
                    <ellipse cx="50" cy="60" rx="14" ry="10" fill="${p.sub}"/>
                    <circle cx="43" cy="50" r="6" fill="${p.eye}"/>
                    <circle cx="57" cy="50" r="6" fill="${p.eye}"/>
                    <circle cx="44" cy="49" r="2" fill="#fff"/>
                    <circle cx="58" cy="49" r="2" fill="#fff"/>
                    <path d="M46 64 Q50 68 54 64" stroke="#0f380f" stroke-width="2.5" fill="none"/>
                `;
            } else if (shapeType === 3) {
                // 重厚タフモンスター系
                svgContent = `
                    <rect x="18" y="30" width="64" height="50" rx="20" fill="${p.main}" stroke="#0f380f" stroke-width="3"/>
                    <polygon points="25,30 35,15 45,30" fill="${p.accent}"/>
                    <polygon points="55,30 65,15 75,30" fill="${p.accent}"/>
                    <rect x="30" y="45" width="40" height="25" rx="8" fill="${p.sub}"/>
                    <ellipse cx="38" cy="52" rx="5" ry="7" fill="${p.eye}"/>
                    <ellipse cx="62" cy="52" rx="5" ry="7" fill="${p.eye}"/>
                    <line x1="40" y1="72" x2="60" y2="72" stroke="#0f380f" stroke-width="4" stroke-linecap="round"/>
                `;
            } else if (shapeType === 4) {
                // 翼付きファンタジー系
                svgContent = `
                    <path d="M20 50 Q10 20 35 40 Z" fill="${p.sub}"/>
                    <path d="M80 50 Q90 20 65 40 Z" fill="${p.sub}"/>
                    <ellipse cx="50" cy="55" rx="20" ry="24" fill="${p.main}" stroke="#0f380f" stroke-width="3"/>
                    <circle cx="42" cy="48" r="5" fill="${p.eye}"/>
                    <circle cx="58" cy="48" r="5" fill="${p.eye}"/>
                    <circle cx="50" cy="32" r="8" fill="${p.accent}"/>
                    <path d="M44 62 Q50 67 56 62" stroke="#0f380f" stroke-width="2.5" fill="none"/>
                `;
            } else {
                // 菱形・神秘系
                svgContent = `
                    <polygon points="50,15 80,55 50,95 20,55" fill="${p.main}" stroke="#0f380f" stroke-width="3"/>
                    <polygon points="50,30 65,55 50,80 35,55" fill="${p.sub}"/>
                    <circle cx="43" cy="50" r="4.5" fill="${p.eye}"/>
                    <circle cx="57" cy="50" r="4.5" fill="${p.eye}"/>
                    <circle cx="50" cy="55" r="4" fill="${p.accent}"/>
                `;
            }

            return `<svg viewBox="0 0 100 100" width="100%" height="100%" style="${scaleStyle}">${svgContent}</svg>`;
        }

        // たまごSVG
        function generateEggSvg() {
            return `
            <svg viewBox="0 0 100 100" width="100%" height="100%">
                <ellipse cx="50" cy="55" rx="28" ry="36" fill="#f4f1de" stroke="#0f380f" stroke-width="4"/>
                <path d="M 36 42 C 42 32, 58 32, 64 42 C 58 52, 42 52, 36 42 Z" fill="#7209b7" opacity="0.6"/>
                <circle cx="42" cy="65" r="5" fill="#4ea8de"/>
                <circle cx="60" cy="72" r="4" fill="#ffb703"/>
            </svg>`;
        }

        // 全100キャラ構築
        const ALL_CHARACTERS = [];
        for (let i = 1; i <= 100; i++) {
            ALL_CHARACTERS.push({
                id: i,
                name: JAPANESE_NAMES[(i - 1) % JAPANESE_NAMES.length],
                catIndex: (i - 1) % 5
            });
        }

        // --- 4. ゲーム状態管理 ---
        let petState = {
            generation: 1,
            stage: 1,           // 1:卵, 2:ベビー, 3:キッズ, 4:ヤング, 5:大人(最終形態)
            charId: 1,
            care: 30,
            affection: 0,
            speed: 0,
            age: 0,
            isMarrying: false,
            isAscending: false,
            unlockedChars: [1],
            lastSave: Date.now()
        };

        // --- 初期化 ---
        window.onload = function() {
            loadGame();
            updateUI();
            
            // 経過タイマー (10秒ごとにお世話減少)
            setInterval(gameTick, 10000);
            
            // 年齢増加タイマー (25秒で1才)
            setInterval(() => {
                if (petState.stage > 1 && !petState.isMarrying && !petState.isAscending) {
                    petState.age++;
                    updateUI();
                    saveGame();
                }
            }, 25000);

            // アバタータップ
            document.getElementById('pet-avatar-container').addEventListener('click', () => {
                if (petState.isMarrying) {
                    acceptMarriage();
                } else {
                    actionPet();
                }
            });
        };

        // --- UI更新 ---
        function updateUI() {
            const charInfo = ALL_CHARACTERS.find(c => c.id === petState.charId) || ALL_CHARACTERS[0];

            document.getElementById('stage-title').innerText = `STAGE: ${petState.stage}`;
            document.getElementById('gen-display').innerText = `${petState.generation}代目 / ${petState.age}才`;

            document.getElementById('care-bar').style.width = petState.care + "%";
            document.getElementById('care-val').innerText = petState.care + "%";

            document.getElementById('affection-bar').style.width = (petState.affection * 10) + "%";
            document.getElementById('affection-val').innerText = `${petState.affection}/10`;

            document.getElementById('speed-bar').style.width = Math.min(petState.speed, 100) + "%";
            document.getElementById('speed-val').innerText = petState.speed;

            const svgContainer = document.getElementById('pet-svg-renderer');
            const avatarBox = document.getElementById('pet-avatar-container');
            const nameTag = document.getElementById('char-name-tag');

            if (petState.stage === 1) {
                svgContainer.innerHTML = generateEggSvg();
                nameTag.innerText = "怪しい卵";
                avatarBox.className = "w-28 h-28 flex items-center justify-center cursor-pointer select-none filter drop-shadow-md anim-egg";
            } else {
                svgContainer.innerHTML = generatePixelArtSvg(petState.charId);
                nameTag.innerText = charInfo.name;
                if (!petState.isAscending) {
                    avatarBox.className = "w-28 h-28 flex items-center justify-center cursor-pointer select-none filter drop-shadow-md anim-bounce";
                }
            }

            const partnerEl = document.getElementById('partner-avatar');
            const btnFeedTxt = document.getElementById('btn-feed-txt');
            const btnPlayTxt = document.getElementById('btn-play-txt');
            const btnPetTxt = document.getElementById('btn-pet-txt');

            if (petState.isMarrying) {
                partnerEl.classList.remove('hidden');
                const partnerId = (petState.charId % 100) + 1;
                partnerEl.innerHTML = generatePixelArtSvg(partnerId);
                document.getElementById('msg-box').innerText = "プロポーズされた！ (結婚する？)";
                btnFeedTxt.innerText = "結婚する";
                btnPlayTxt.innerText = "結婚する";
                btnPetTxt.innerText = "結婚する";
            } else {
                partnerEl.classList.add('hidden');
                btnFeedTxt.innerText = "ごはん";
                btnPlayTxt.innerText = "あそぶ";
                btnPetTxt.innerText = "なでる";

                const statusMsg = document.getElementById('status-msg');
                if (petState.care < 35) {
                    statusMsg.innerText = "お腹がすいたよ…";
                    statusMsg.classList.add("text-red-700", "animate-pulse");
                } else if (petState.care >= 80) {
                    statusMsg.innerText = "とても元気！";
                    statusMsg.classList.remove("text-red-700", "animate-pulse");
                } else {
                    statusMsg.innerText = "順調に育成中！";
                    statusMsg.classList.remove("text-red-700", "animate-pulse");
                }
            }

            document.getElementById('comp-rate').innerText = `図鑑: ${petState.unlockedChars.length} / 100`;
        }

        function showMessage(msg) {
            document.getElementById('msg-box').innerText = msg;
        }

        function spawnParticle(emoji) {
            const container = document.getElementById('particle-layer');
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.innerText = emoji;
            const randomX = (Math.random() - 0.5) * 60;
            particle.style.left = `calc(50% + ${randomX}px)`;
            particle.style.top = `40%`;
            container.appendChild(particle);
            setTimeout(() => particle.remove(), 1000);
        }

        // --- アクション ---
        function actionFeed() {
            playSfx('button');
            if (petState.isMarrying) { acceptMarriage(); return; }
            if (petState.stage === 1) { hatchEgg(); return; }
            if (petState.isAscending) return;

            if (petState.care >= 100) {
                showMessage("もうお腹いっぱい！");
                return;
            }

            playSfx('feed');
            petState.care = Math.min(100, petState.care + 25);
            spawnParticle("🍖");
            showMessage("美味しい肉を食べた！");
            
            checkEvolution();
            updateUI();
            saveGame();
        }

        function actionPlay() {
            playSfx('button');
            if (petState.isMarrying) { acceptMarriage(); return; }
            if (petState.stage === 1) { hatchEgg(); return; }
            if (petState.isAscending) return;

            playSfx('play');
            petState.speed = Math.min(100, petState.speed + 10);
            petState.care = Math.max(0, petState.care - 4);
            spawnParticle("⚔️");
            showMessage("激しい特訓をした！すばやさUP");

            checkEvolution();
            updateUI();
            saveGame();
        }

        function actionPet() {
            playSfx('button');
            if (petState.isMarrying) { acceptMarriage(); return; }
            if (petState.stage === 1) { hatchEgg(); return; }
            if (petState.isAscending) return;

            playSfx('pet');
            if (petState.affection < 10) {
                petState.affection = Math.min(10, petState.affection + 1);
                spawnParticle("✨");
                showMessage("なでてあげた！機嫌がいい");
            } else {
                spawnParticle("💖");
                showMessage("愛情が最大値に達している！");
            }

            checkEvolution();
            updateUI();
            saveGame();
        }

        function hatchEgg() {
            playSfx('feed');
            petState.care += 30;
            spawnParticle("✨");
            if (petState.care >= 100) {
                triggerEvolution(2);
            } else {
                showMessage(`卵がぐらりと揺れた (${petState.care}%)`);
            }
            updateUI();
            saveGame();
        }

        function gameTick() {
            if (petState.stage > 1 && !petState.isMarrying && !petState.isAscending) {
                petState.care = Math.max(0, petState.care - 4);
                updateUI();
                saveGame();
            }
        }

        // --- 進化・結婚・天昇・図鑑ロジック ---
        function checkEvolution() {
            if (petState.stage === 2 && petState.care >= 50 && petState.affection >= 3) {
                triggerEvolution(3);
            } else if (petState.stage === 3 && petState.care >= 75 && petState.speed >= 30) {
                triggerEvolution(4);
            } else if (petState.stage === 4 && petState.care >= 90 && petState.affection >= 8 && petState.speed >= 60) {
                triggerEvolution(5);
            }
        }

        function triggerEvolution(nextStage) {
            playSfx('evo');

            let nextCharId = petState.charId;
            if (nextStage === 5) {
                const uncollected = ALL_CHARACTERS.map(c => c.id).filter(id => !petState.unlockedChars.includes(id));
                if (uncollected.length > 0) {
                    nextCharId = uncollected[Math.floor(Math.random() * uncollected.length)];
                } else {
                    nextCharId = Math.floor(Math.random() * 100) + 1;
                }
            } else {
                nextCharId = Math.min(100, petState.charId + Math.floor(Math.random() * 6) + 1);
            }

            const overlay = document.getElementById('evo-overlay');
            const evoSvgRenderer = document.getElementById('evo-svg-renderer');
            const evoText = document.getElementById('evo-text');
            const evoSubtext = document.getElementById('evo-subtext');

            evoSvgRenderer.innerHTML = petState.stage === 1 ? generateEggSvg() : generatePixelArtSvg(petState.charId);
            evoSubtext.innerText = "未知なる進化エネルギー…！";
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');

            let flashes = 0;
            const flashInterval = setInterval(() => {
                flashes++;
                evoSvgRenderer.innerHTML = flashes % 2 === 0 ? generatePixelArtSvg(nextCharId) : generateEggSvg();

                if (flashes > 8) {
                    clearInterval(flashInterval);
                    petState.stage = nextStage;
                    petState.charId = nextCharId;

                    if (!petState.unlockedChars.includes(nextCharId)) {
                        petState.unlockedChars.push(nextCharId);
                    }

                    evoSvgRenderer.innerHTML = generatePixelArtSvg(nextCharId);
                    const newChar = ALL_CHARACTERS.find(c => c.id === nextCharId);
                    evoText.innerText = `${newChar.name} に進化した！`;
                    
                    setTimeout(() => {
                        overlay.classList.add('hidden');
                        overlay.classList.remove('flex');
                        showMessage(`${newChar.name} が誕生した！`);

                        if (nextStage === 5) {
                            setTimeout(triggerMarriageEvent, 1500);
                        }

                        updateUI();
                        saveGame();

                        if (petState.unlockedChars.length >= 100) {
                            setTimeout(showGameClear, 2000);
                        }
                    }, 1800);
                }
            }, 300);
        }

        function triggerMarriageEvent() {
            petState.isMarrying = true;
            playSfx('marry');
            spawnParticle("💍");
            spawnParticle("💖");
            updateUI();
        }

        function acceptMarriage() {
            if (!petState.isMarrying) return;
            petState.isMarrying = false;
            playSfx('marry');
            spawnParticle("💒");
            spawnParticle("🎉");
            const char = ALL_CHARACTERS.find(c => c.id === petState.charId);
            showMessage(`${char.name} が素敵な相手と結婚！`);

            updateUI();
            saveGame();
            setTimeout(triggerAscension, 3500);
        }

        function triggerAscension() {
            petState.isAscending = true;
            playSfx('ascend');
            const char = ALL_CHARACTERS.find(c => c.id === petState.charId);
            showMessage(`${char.name} が天へ召され、殿堂入りへ…`);
            
            const avatarBox = document.getElementById('pet-avatar-container');
            avatarBox.className = "w-28 h-28 flex items-center justify-center select-none filter drop-shadow-md anim-ascend";

            for (let i = 0; i < 5; i++) {
                setTimeout(() => spawnParticle("✨"), i * 400);
                setTimeout(() => spawnParticle("👼"), i * 500);
            }

            setTimeout(() => {
                petState.isAscending = false;
                petState.generation++;
                petState.stage = 1;
                petState.care = 30;
                petState.affection = 0;
                petState.speed = 0;
                petState.age = 0;
                petState.charId = 1;

                showMessage("新しい世代の卵を受け継ぎました");
                updateUI();
                saveGame();
                toggleBookView(true);
            }, 3800);
        }

        // --- 図鑑機能 ---
        function toggleBookView(forceOpen = false) {
            playSfx('button');
            const bookView = document.getElementById('view-book');
            if (forceOpen || bookView.classList.contains('hidden')) {
                renderBookGrid();
                bookView.classList.remove('hidden');
                bookView.classList.add('flex');
            } else {
                bookView.classList.add('hidden');
                bookView.classList.remove('flex');
            }
        }

        function renderBookGrid() {
            const grid = document.getElementById('book-grid');
            document.getElementById('book-count').innerText = petState.unlockedChars.length;
            grid.innerHTML = "";

            ALL_CHARACTERS.forEach(char => {
                const isUnlocked = petState.unlockedChars.includes(char.id);
                const item = document.createElement('div');
                item.className = `flex flex-col items-center justify-center p-1.5 rounded border border-[#0f380f] ${isUnlocked ? 'bg-[#8bac0f]' : 'bg-[#306230]'}`;
                
                const svgContent = generatePixelArtSvg(char.id, !isUnlocked);

                item.innerHTML = `
                    <div class="w-10 h-10 mb-0.5">${svgContent}</div>
                    <div class="text-[9px] font-bold text-[#0f380f] truncate w-full text-center">
                        ${isUnlocked ? char.name : '???'}
                    </div>
                `;
                grid.appendChild(item);
            });
        }

        function showGameClear() {
            playSfx('evo');
            document.getElementById('clear-svg-container').innerHTML = generatePixelArtSvg(100);
            const overlay = document.getElementById('clear-overlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
        }

        function restartAfterClear() {
            playSfx('button');
            document.getElementById('clear-overlay').classList.add('hidden');
            document.getElementById('clear-overlay').classList.remove('flex');
        }

        // --- セーブ & リセット ---
        function saveGame() {
            petState.lastSave = Date.now();
            localStorage.setItem('retro_pet_dark_rare_save', JSON.stringify(petState));
        }

        function loadGame() {
            const saved = localStorage.getItem('retro_pet_dark_rare_save');
            if (saved) {
                try {
                    petState = JSON.parse(saved);
                    showMessage("前回のデータから再開しました");
                } catch (e) {
                    console.error(e);
                }
            }
        }

        function confirmReset() {
            playSfx('button');
            if (confirm("データを最初からリセットしますか？\n（図鑑の解放状況もリセットされます）")) {
                localStorage.removeItem('retro_pet_dark_rare_save');
                petState = {
                    generation: 1,
                    stage: 1,
                    charId: 1,
                    care: 30,
                    affection: 0,
                    speed: 0,
                    age: 0,
                    isMarrying: false,
                    isAscending: false,
                    unlockedChars: [1],
                    lastSave: Date.now()
                };
                showMessage("新規データでスタート！");
                updateUI();
            }
        }
    </script>
</body>
</html>
