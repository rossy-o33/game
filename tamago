<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>レトロ風本格育成ゲーム - 悪者・レア系100体完全版</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=DotGothic16&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'DotGothic16', monospace;
            background-color: #12121a;
            color: #1f2937;
            user-select: none;
        }

        .pixel-font {
            font-family: 'Press Start 2P', 'DotGothic16', cursive;
        }

        /* 携帯ゲーム機本体フレーム */
        .handheld-body {
            background: linear-gradient(145deg, #2b2d42, #1d1e2c);
            border: 4px solid #ef233c;
            box-shadow: 
                inset -6px -6px 0px rgba(0, 0, 0, 0.4),
                inset 6px 6px 0px rgba(255, 255, 255, 0.1),
                0 20px 30px rgba(0, 0, 0, 0.6);
            border-radius: 40px 40px 60px 60px;
        }

        /* 液晶画面風フレーム */
        .lcd-screen {
            background-color: #8bac0f;
            border: 4px solid #0f380f;
            box-shadow: inset 4px 4px 8px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
        }

        /* 走査線風オーバーレイ */
        .scanlines {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.1) 50%
            );
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 5;
        }

        /* 3Dレトロボタン */
        .retro-btn {
            background: linear-gradient(180deg, #4ea8de, #0077b6);
            border: 3px solid #03045e;
            box-shadow: 0 5px 0 #023e8a, 0 8px 6px rgba(0,0,0,0.4);
            transition: all 0.05s ease;
            color: #ffffff;
            text-shadow: 1px 1px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
        }

        .retro-btn:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #023e8a, 0 2px 4px rgba(0,0,0,0.4);
        }

        .retro-btn-purple {
            background: linear-gradient(180deg, #b5179e, #7209b7);
            border: 3px solid #240046;
            box-shadow: 0 5px 0 #3a0ca3, 0 8px 6px rgba(0,0,0,0.4);
        }

        .retro-btn-purple:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #240046, 0 2px 4px rgba(0,0,0,0.4);
        }

        .retro-btn-red {
            background: linear-gradient(180deg, #ff4d6d, #d90429);
            border: 3px solid #590d22;
            box-shadow: 0 5px 0 #800f2f, 0 8px 6px rgba(0,0,0,0.4);
        }

        .retro-btn-red:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #590d22, 0 2px 4px rgba(0,0,0,0.4);
        }

        .retro-btn-yellow {
            background: linear-gradient(180deg, #ffb703, #fb8500);
            border: 3px solid #9e2a2b;
            box-shadow: 0 5px 0 #d4a373, 0 8px 6px rgba(0,0,0,0.4);
        }

        .retro-btn-yellow:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #9e2a2b, 0 2px 4px rgba(0,0,0,0.4);
        }

        /* アニメーション */
        @keyframes eggSway {
            0%, 100% { transform: rotate(-6deg) translateY(0); }
            50% { transform: rotate(6deg) translateY(-4px); }
        }

        @keyframes bouncePet {
            0%, 100% { transform: translateY(0) scale(1, 1); }
            50% { transform: translateY(-10px) scale(1.06, 0.94); }
        }

        @keyframes floatAscend {
            0% { opacity: 1; transform: translateY(0) scale(1); }
            100% { opacity: 0; transform: translateY(-140px) scale(1.6); }
        }

        @keyframes floatParticle {
            0% { opacity: 1; transform: translateY(0) scale(0.8); }
            100% { opacity: 0; transform: translateY(-50px) scale(1.5); }
        }

        @keyframes flashFlash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.1; }
        }

        .anim-egg { animation: eggSway 1.8s infinite ease-in-out; }
        .anim-bounce { animation: bouncePet 0.8s infinite ease-in-out; }
        .anim-ascend { animation: floatAscend 3.5s forwards ease-in-out; }
        .anim-flash { animation: flashFlash 0.3s infinite; }

        .particle {
            position: absolute;
            pointer-events: none;
            animation: floatParticle 1s forwards ease-out;
            font-size: 24px;
            z-index: 30;
        }

        /* プログレスバー */
        .bar-bg {
            background-color: #306230;
            border: 2px solid #0f380f;
        }
        .bar-fill {
            background-color: #9bbc0f;
        }

        /* 図鑑用スクロール */
        .book-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .book-scroll::-webkit-scrollbar-track {
            background: #306230;
        }
        .book-scroll::-webkit-scrollbar-thumb {
            background: #9bbc0f;
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">

